--- a/app/assets/styles.css
+++ b/app/assets/styles.css
@@ -5713,3 +5713,108 @@
 .display-range-bar--compact > .display-range-content {
     overscroll-behavior: contain;
 }
+/* Keep the spectrogram dialog and its controls usable on narrow/short screens. */
+.spectrogram-zoom-modal .modal-dialog {
+    width: calc(100% - 24px);
+    max-width: 1140px;
+    margin: 12px auto;
+}
+
+.spectrogram-zoom-modal .modal-content {
+    max-height: calc(100vh - 24px);
+    max-height: calc(100dvh - 24px);
+    overflow: hidden;
+}
+
+.spectrogram-zoom-modal .modal-header,
+.spectrogram-zoom-modal .modal-footer {
+    flex: 0 0 auto;
+    padding: 12px 16px;
+}
+
+.spectrogram-zoom-modal .modal-body {
+    min-height: 0;
+    overflow-y: auto;
+    overscroll-behavior: contain;
+    padding: 16px !important;
+}
+
+.spectrogram-zoom-modal .modal-header-row {
+    display: grid;
+    grid-template-columns: minmax(0, 1fr) auto auto;
+    align-items: center;
+    gap: 8px 12px;
+    min-width: 0;
+}
+
+.spectrogram-zoom-modal .modal-title-text {
+    min-width: 0;
+    overflow-wrap: anywhere;
+    font-size: 18px;
+    line-height: 1.3;
+    max-height: 3.9em;
+    overflow-y: auto;
+}
+
+.spectrogram-zoom-modal .modal-nav-controls {
+    width: auto;
+    flex-wrap: nowrap;
+}
+
+.spectrogram-zoom-modal .modal-header-close-btn {
+    align-self: center;
+    margin: 0;
+}
+
+.spectrogram-zoom-modal #modal-image-graph {
+    height: clamp(240px, 50vh, 500px) !important;
+    height: clamp(240px, 50dvh, 500px) !important;
+    min-width: 0;
+}
+
+@media (max-width: 767px) {
+    .spectrogram-zoom-modal .modal-header-row {
+        grid-template-columns: minmax(0, 1fr) auto;
+    }
+
+    .spectrogram-zoom-modal .modal-title-text {
+        font-size: 16px;
+        max-height: 6.5em;
+    }
+
+    .spectrogram-zoom-modal .modal-header-close-btn {
+        grid-column: 2;
+        grid-row: 1;
+    }
+
+    .spectrogram-zoom-modal .modal-nav-controls {
+        grid-column: 1 / -1;
+        grid-row: 2;
+        justify-content: center;
+    }
+
+    .spectrogram-zoom-modal .modal-body {
+        padding: 12px !important;
+    }
+
+    .spectrogram-zoom-modal .display-range-slider-row {
+        display: grid;
+        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
+    }
+
+    .spectrogram-zoom-modal .display-range-slider-shell {
+        grid-column: 1 / -1;
+        grid-row: 2;
+    }
+
+    .spectrogram-zoom-modal .display-range-manual-input {
+        min-width: 0;
+        width: 100%;
+    }
+}
+
+@media (max-height: 500px) {
+    .spectrogram-zoom-modal .modal-title-text {
+        max-height: 2.6em;
+    }
+}
